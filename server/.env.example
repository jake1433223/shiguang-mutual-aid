# ============================================================
# 拾光互助后端环境变量模板
# 本地开发：复制为 .env（默认使用 SQLite，零运维）
# 生产环境：在部署平台（Railway/Render 等）配置以下变量
# ============================================================

# ── 数据库 ──────────────────────────────────────────────────
# 本地开发（SQLite）：
#   DATABASE_URL="file:./dev.db"
# 生产环境（PostgreSQL，推荐 Neon 免费版）：
#   DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&connect_timeout=30"
#   （connect_timeout=30 必须加：Neon 免费版冷启动约 5 秒，Prisma 默认超时会连不上）
# 本地开发初始化：npx prisma db push --schema prisma/schema.prisma
# 生产部署后需执行：npx prisma migrate deploy --schema prisma/schema.postgresql.prisma
DATABASE_URL="file:./dev.db"

# ── JWT ─────────────────────────────────────────────────────
# 生产环境必须替换为强随机密钥！生成方式：
#   openssl rand -base64 48
# 或使用 Node：node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="shiguang-dev-secret-change-in-production-2026"
JWT_EXPIRES_IN="2h"

# ── 服务 ────────────────────────────────────────────────────
PORT=3000
# CORS 允许的前端来源（生产环境填写前端域名，多个用逗号分隔）
# 如：CORS_ORIGIN="https://shiguang.vercel.app"
CORS_ORIGIN="http://localhost:5173"

# ============================================================
# 邮件服务（SMTP）
# 本地开发：留空则自动创建 Ethereal 测试账号（邮件不真正发送）
# 生产环境：必须配置真实 SMTP（如 Resend / Brevo / 阿里云邮件推送）
#   Resend 免费版示例：
#     SMTP_HOST="smtp.resend.com"
#     SMTP_PORT="465"
#     SMTP_USER="resend"
#     SMTP_PASS="re_xxxxxxxx"
# ============================================================
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="拾光互助 <no-reply@shiguang.dev>"

# 前端地址（用于拼验证/重置链接，生产环境填写前端域名）
APP_URL="http://localhost:5173"

# ============================================================
# 管理员账号（仅 seed 首次创建时读取，之后请通过后台修改密码）
# ============================================================
ADMIN_EMAIL="admin@shiguang.dev"
ADMIN_PASSWORD="Admin@2026"
