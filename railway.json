{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd server && npm install && npx prisma generate --schema prisma/schema.postgresql.prisma && npm run build"
  },
  "deploy": {
    "startCommand": "cd server && node dist/src/main.js",
    "healthcheckPath": "/api/stats/overview",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
