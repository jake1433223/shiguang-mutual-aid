# 拾光互助 - 阿里云 ECS 部署环境变量
# 复制为 .env 并修改后执行: docker compose up -d --build

# 数据库
POSTGRES_DB=shiguang
POSTGRES_USER=shiguang
POSTGRES_PASSWORD=please-change-db-password

# JWT 密钥（务必改成强随机值）
JWT_SECRET=please-change-this-jwt-secret-to-a-strong-random-value

# 公网访问地址（有域名后替换成 https://你的域名）
CORS_ORIGIN=http://你的域名
APP_URL=http://你的域名

# 对外开放端口（默认 80）
HTTP_PORT=80

# 邮件 SMTP（可选，留空为测试模式）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=拾光互助 <no-reply@shiguang.dev>

# 管理员初始账号（首次 seed 时使用）
ADMIN_EMAIL=admin@shiguang.dev
ADMIN_PASSWORD=Admin@2026
